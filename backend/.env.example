# Server Port
PORT=5000

# Firebase Service Account Credentials
# Option 1: File path to downloaded serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH="./serviceAccountKey.json"

# Option 2: Raw JSON string of the service account (ideal for deployment e.g. Render, Railway, Heroku)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"myresturent-13093",...}'

# Firebase Project ID
FIREBASE_PROJECT_ID="myresturent-13093"

# Node Environment
NODE_ENV=development
